                      <div class="d-flex gap-2 flex-wrap ms-2 align-items-center">
                          <button class="btn-notif btn-notif-sec" onclick="resetFilters()" style="padding: 8px 16px; border-radius: 12px;"><i class="bi bi-eraser-fill"></i> Limpar</button>
                          
                          <div class="dropdown">
                              <button class="btn-notif btn-notif-pri dropdown-toggle" type="button" data-bs-toggle="dropdown" style="border-radius: 12px;" id="btnExportExcelMain">
                                  <i class="bi bi-file-earmark-excel-fill"></i> EXCEL
                              </button>
                              <ul class="dropdown-menu dropdown-menu-end shadow" style="font-size: 0.85rem; z-index: 9999; border-radius: 12px; border: 1px solid var(--border-color); background: var(--card-bg);">
                                  <li><h6 class="dropdown-header fw-bold text-uppercase" style="color:var(--accent)">Separado por Processo</h6></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToExcel(1)">Com Material e Dimensão</a></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToExcel(2)">Apenas Mobília</a></li>
                                  <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                                  <li><h6 class="dropdown-header fw-bold text-uppercase" style="color:var(--accent)">Sem Processo (Consolidado)</h6></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToExcel(3)">Com Material e Dimensão</a></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToExcel(4)">Apenas Mobília (Geral)</a></li>
                              </ul>
                          </div>

                          <div class="dropdown">
                              <button class="btn-notif text-white dropdown-toggle" type="button" data-bs-toggle="dropdown" style="background-color: #d32f2f; border-radius: 12px;" id="btnExportPDFMain">
                                  <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                              </button>
                              <ul class="dropdown-menu dropdown-menu-end shadow" style="font-size: 0.85rem; z-index: 9999; border-radius: 12px; border: 1px solid var(--border-color); background: var(--card-bg);">
                                  <li><h6 class="dropdown-header fw-bold text-uppercase" style="color:var(--accent)">Separado por Processo</h6></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToPDF(1)">Com Material e Dimensão</a></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToPDF(2)">Apenas Mobília</a></li>
                                  <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                                  <li><h6 class="dropdown-header fw-bold text-uppercase" style="color:var(--accent)">Sem Processo (Consolidado)</h6></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToPDF(3)">Com Material e Dimensão</a></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToPDF(4)">Apenas Mobília (Geral)</a></li>
                              </ul>
                          </div>
                      </div>
                  </div>
                  
                  <div class="collapse mt-3" id="collapseFilters">
                      <div class="row g-3">
                          <div class="col-lg-3 border-end" style="border-color: var(--border-color) !important;">
                              <label class="small fw-bold mb-1 text-uppercase" style="color: var(--text-muted); font-size: 0.75rem;">1. Selecione a Oficina</label>
                              <select id="selOficina" class="form-select oficina-selector mb-3" onchange="applyFilters('oficina')">
                                  <option value="TODAS" selected>TODAS AS OFICINAS</option>
                                  <option value="SEDE">MARCENARIA SEDE</option>
                                  <option value="REGIONAL">MARCENARIA REGIONAL</option>
                              </select>
                              
                              <label class="small fw-bold mb-1 text-uppercase" style="color: var(--text-muted); font-size: 0.75rem;">Data de Entrega</label>
                              <div class="d-flex gap-2 mb-3">
                                  <input type="date" id="filterDateStart" class="form-control oficina-selector" style="font-weight: normal; font-size: 0.85rem; padding: 10px;" onchange="applyFilters('date')">
                                  <input type="date" id="filterDateEnd" class="form-control oficina-selector" style="font-weight: normal; font-size: 0.85rem; padding: 10px;" onchange="applyFilters('date')">
                              </div>

                              <label class="small fw-bold mb-1 text-uppercase" style="color: var(--text-muted); font-size: 0.75rem;">Pesquisa por Palavra</label>
                              <input type="text" id="globalSearchInput" class="form-control oficina-selector" placeholder="Digite para filtrar..." style="font-weight: normal; font-size: 0.9rem;" onkeyup="applyFilters('global')">
                          </div>
                          <div class="col-lg-9">
