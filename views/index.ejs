<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <base target="_top">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  
  <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  
  <!-- FONTES E ÍCONES SERRALHERIA -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  
  <link rel="icon" type="image/png" href="/images/logo.png">
  
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
  <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
  
  <style>
    /* PADRÃO GLOBAL SERRALHERIA */
    :root {
      --bg-color: #f8fafc; 
      --card-bg: #ffffff; 
      --sidebar-bg: #001E7A;
      --text-main: #1e293b; 
      --text-muted: #64748b; 
      --accent: #001E7A; 
      --accent-dark: #001557;
      --accent-light: #e0e7ff;
      --border-color: #e2e8f0; 
      --input-bg: #f1f5f9;
      --shadow: 0 4px 15px rgba(0,0,0,0.05);
      
      --success: #1b5e20; --success-bg: #e8f5e9;
      --warning: #e65100; --warning-bg: #fff3e0; --warning-text-dark: #e65100;
      --danger: #b71c1c; --danger-bg: #ffebee;
      --neutral: #424242; --neutral-bg: #f5f5f5;
      --table-row-hover: #fcfdfe;
      --chart-grid: #e2e8f0;

      /* Mapeamento das variáveis antigas para não quebrar o JS */
      --bg-page: var(--bg-color); --text-pri: var(--text-main); --text-sec: var(--text-muted);
      --highlight: var(--accent); --dropdown-bg: var(--card-bg); --hover-item: var(--input-bg);
      --input-text: var(--text-main);
      --st-sol: var(--accent); --st-ent: var(--success); --st-pen: var(--warning-text-dark); 
    }

    body.dark-mode {
      --bg-color: #121416; --card-bg: #1c2126; --sidebar-bg: #1c2126;
      --text-main: #f0f2f5; --text-muted: #a0abb5;
      --accent: #b0bec5; --accent-dark: #78909c;
      --accent-light: #23292e;
      --border-color: #2a3138; --input-bg: #23292e;
      --shadow: 0 10px 30px rgba(0,0,0,0.3);
      --chart-grid: #333333;
      --success-bg: rgba(46, 125, 50, 0.2); --warning-bg: rgba(255, 152, 0, 0.1); --danger-bg: rgba(198, 40, 40, 0.2);
      --table-row-hover: #2a3138;

      --bg-page: var(--bg-color); --text-pri: var(--text-main); --text-sec: var(--text-muted);
      --highlight: var(--accent); --dropdown-bg: var(--card-bg); --hover-item: var(--input-bg);
      --input-text: var(--text-main);
    }
    
    html, body { 
      background-color: var(--bg-page); color: var(--text-pri); 
      font-family: 'Poppins', sans-serif; transition: 0.3s; 
      max-width: 100vw; overflow-x: hidden; margin: 0; padding: 0;
    }
    * { box-sizing: border-box; }
    
    .text-uppercase-force { text-transform: uppercase !important; }

    .layout-wrapper { display: flex; min-height: 100vh; position: relative; width: 100%; max-width: 100vw; overflow-x: hidden; }
    
    .sidebar-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 90; backdrop-filter: blur(2px); }
    .sidebar-overlay.show { display: block; }

    .sidebar {
        width: 320px; background-color: var(--sidebar-bg); border-right: 1px solid var(--border-color);
        display: flex; flex-direction: column; align-items: flex-start; padding-top: 25px; transition: left 0.3s;
        z-index: 1000; position: fixed; top: 0; bottom: 0; left: 0; overflow-x: hidden; white-space: nowrap; gap: 10px;
    }
    .main-content { margin-left: 320px; width: calc(100vw - 320px); padding: 30px; transition: margin-left 0.3s, width 0.3s; overflow-x: hidden; }
    
    .nav-btn {
        width: calc(100% - 40px); margin: 0 20px; height: 54px; border-radius: 14px; display: flex; align-items: center; justify-content: flex-start; padding-left: 15px; color: #ffffff; cursor: pointer; transition: 0.3s all ease; border: none; text-decoration: none; background: transparent; font-family: 'Poppins', sans-serif;
    }
    .nav-btn i { font-size: 24px; min-width: 34px; text-align: left; }
    .nav-btn span { font-size: 1.05rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; margin-left: 5px; }
    .nav-btn:hover { background: rgba(255, 255, 255, 0.1); color: #ffffff; }
    .nav-btn.active { background: #ffffff !important; color: var(--sidebar-bg) !important; box-shadow: 0 6px 15px rgba(0, 0, 0, 0.25); }
    
    .filter-chevron { transition: transform 0.3s ease; display: inline-block; }
    [aria-expanded="true"] .filter-chevron { transform: rotate(180deg); }

    /* REDESIGN DROPDOWNS SERRALHERIA */
    .custom-dropdown-btn {
        background-color: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-main);
        text-align: left; display: flex; justify-content: space-between; align-items: center;
        width: 100%; padding: 12px 18px; border-radius: 12px; font-weight: 500; transition: 0.2s;
        text-transform: uppercase; font-size: 0.95rem; font-family: 'Poppins', sans-serif;
    }
    .custom-dropdown-btn:hover { border-color: var(--highlight); color: var(--highlight); }
    .dropdown-menu-custom {
        background-color: var(--card-bg); border: 1px solid var(--border-color);
        padding: 10px; border-radius: 16px; box-shadow: var(--shadow);
        max-height: 400px; width: 100%; min-width: 250px; z-index: 1050; max-width: 90vw;
    }
    .dropdown-search {
        background-color: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-main);
        border-radius: 8px; padding: 10px; margin-bottom: 8px; width: 100%; text-transform: uppercase; font-family: 'Poppins', sans-serif; font-size: 0.9rem;
    }
    .dropdown-search:focus { outline: none; border-color: var(--highlight); }
    .dropdown-list-container { max-height: 250px; overflow-y: auto; overflow-x: hidden; }
    .dropdown-list-container::-webkit-scrollbar { width: 6px; }
    .dropdown-list-container::-webkit-scrollbar-thumb { background-color: var(--highlight); border-radius: 3px; }
    
    .dropdown-item-custom {
        display: flex; align-items: center; padding: 8px; border-radius: 6px;
        cursor: pointer; color: var(--text-main); transition: 0.2s; text-transform: uppercase; font-size: 0.9rem; border-bottom: none; font-weight: 500;
    }
    .dropdown-item-custom:hover { background-color: var(--input-bg); }
    .form-check-input {
        width: 16px; height: 16px; margin-right: 10px; cursor: pointer;
        background-color: var(--card-bg); border-color: var(--border-color); accent-color: var(--accent);
    }
    .form-check-input:checked { background-color: var(--highlight); border-color: var(--highlight); }
    
    /* CARDS */
    .card-custom { background: var(--card-bg); border: none; border-radius: 20px; box-shadow: var(--shadow); max-width: 100%; overflow: visible; }
    
    .oficina-selector {
        background-color: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-color);
        font-weight: 500; border-radius: 12px; padding: 12px 18px; width: 100%; cursor: pointer; max-width: 100%;
        font-family: 'Poppins', sans-serif; font-size: 0.95rem; text-transform: uppercase;
    }
    .oficina-selector:focus { border-color: var(--accent); box-shadow: none; }
    .oficina-selector option { background-color: var(--card-bg); color: var(--text-main); }
    
    .kpi-card { 
      background: var(--card-bg); border-radius: 20px; padding: 25px 20px; 
      box-shadow: var(--shadow); text-align: center; border: none; position: relative;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .kpi-card.blue { border-left: 5px solid var(--accent); }
    .kpi-card.green { border-left: 5px solid var(--success); }
    .kpi-card.yellow { border-left: 5px solid var(--warning-text-dark); }
    .kpi-label { font-size: 0.85rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 5px; }
    .kpi-val { font-size: 2.2rem; font-weight: 800; color: var(--text-main); line-height: 1.1; }
    
    .viz-box { 
      background: var(--card-bg); border-radius: 20px; padding: 25px; 
      box-shadow: var(--shadow); border: none;
      position: relative; height: 100%; min-height: 550px; display: flex; flex-direction: column; width: 100%; overflow: hidden;
    }
    .chart-container { flex: 1; position: relative; min-width: 0; min-height: 0; width: 100%; }
    .chart-header { font-weight: 800; color: var(--text-main); text-transform: uppercase; font-size: 1.2rem; margin-bottom: 15px; }
    
    .table-box { flex: 1; overflow-x: auto; width: 100%; max-width: 100%; }
    
    /* TABELAS SERRALHERIA */
    .custom-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .custom-table th { background: var(--accent); color: #fff; position: sticky; top: 0; padding: 15px; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; border: 1px solid var(--border-color); z-index: 10; white-space: nowrap; text-align: left; vertical-align: middle; }
    .custom-table td { padding: 12px 15px; font-size: 0.85rem; color: var(--text-main); border: 1px solid var(--border-color); vertical-align: middle; font-weight: 500; }
    .custom-table tbody tr.parent-row { cursor: pointer; transition: background 0.2s; border-bottom: 1px solid var(--border-color); }
    .custom-table tbody tr.parent-row:hover { background-color: var(--table-row-hover); }
    .custom-table tbody tr.parent-row[aria-expanded="true"] { background-color: var(--input-bg); border-left: 4px solid var(--accent); }
    
    .sub-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; background: var(--card-bg); border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); box-shadow: var(--shadow); margin: 15px 0;}
    .sub-table th { background: var(--input-bg) !important; color: var(--text-muted); padding: 12px 15px; font-weight: 800; text-transform: uppercase; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem; text-align: left; }
    .sub-table td { font-size: 0.85rem; color: var(--text-main); padding: 12px 15px; border-bottom: 1px dashed var(--border-color) !important; vertical-align: middle; text-align: left; font-weight: 500;}
    .sub-table td.text-center { text-align: center; }
    
    .sim-input {
        width: 100%; max-width: 70px; padding: 6px; border: 1px solid var(--border-color); border-radius: 8px;
        background-color: var(--input-bg); color: var(--text-main); text-align: center;
        font-weight: 700; font-size: 0.9rem; display: inline-block; margin: 0; font-family: 'Poppins', sans-serif; transition: 0.2s;
    }
    .sim-input:focus { outline: none; border-color: var(--accent); background-color: var(--card-bg); }
    .sim-val-pen { font-weight: 800; color: var(--danger); font-size: 1rem; }

    /* STATUS SERRALHERIA */
    .status-badge { padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; border: none; display: inline-block; text-transform: uppercase; text-align: center; }
    .st-prod { background: var(--warning-bg); color: var(--warning-text-dark); } 
    .st-montagem { background: var(--warning-bg); color: var(--warning-text-dark); }
    .st-planejamento { background: var(--input-bg); color: var(--text-muted); }
    .st-aguardando { background: var(--input-bg); color: var(--text-muted); }
    .st-pendente { background: var(--danger-bg); color: var(--danger); }
    .st-estoque { background: var(--success-bg); color: var(--success); }
    .st-orcamento { background: var(--input-bg); color: var(--text-muted); }
    .st-nao-aut { background: var(--danger-bg); color: var(--danger); }
    .st-arquivado { background: var(--input-bg); color: var(--text-muted); }
    .st-finalizado { background: var(--success-bg); color: var(--success); }
    .st-default { background: var(--input-bg); color: var(--text-muted); }

    .prio-badge { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; font-weight: bold; border: none; font-size: 0.8rem; }
    .prio-1 { background: var(--danger-bg); color: var(--danger); }
    .prio-2 { background: var(--warning-bg); color: var(--warning-text-dark); }
    .prio-3 { background: var(--warning-bg); color: var(--warning-text-dark); }
    .prio-4 { background: var(--success-bg); color: var(--success); }
    .prio-5 { background: var(--input-bg); color: var(--text-muted); }
    .prio-default { background: var(--input-bg); color: var(--text-muted); }

    .date-alert { color: var(--danger) !important; font-weight: 800 !important; }

    .detail-row > td { padding: 0 !important; border: none !important; }
    .detail-row > td::before { display: none !important; }
    
    .parent-row .bi-chevron-down { transition: transform 0.3s; color: var(--accent); }
    .parent-row[aria-expanded="true"] .bi-chevron-down { transform: rotate(180deg); }

    .pagination-container { display: flex; justify-content: space-between; align-items: center; padding: 15px 0 0 0; margin-top: 15px; border-top: 1px solid var(--border-color); }
    .pagination-btn { background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 16px; border-radius: 8px; cursor: pointer; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.85rem; transition: 0.2s;}
    .pagination-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .pagination-btn:hover:not(:disabled) { background-color: var(--input-bg); border-color: var(--accent); color: var(--accent); }

    .loader-overlay { position: fixed; top:0; left:0; width:100%; height:100%; background: var(--bg-color); display:flex; flex-direction:column; justify-content:center; align-items:center; z-index:9999; overflow: hidden; transition: opacity 0.5s ease-out;}
    body.loaded .loader-overlay { opacity: 0; pointer-events: none; }
    .spinner-border { width: 60px; height: 60px; border: 5px solid var(--border-color); border-top: 5px solid var(--accent); border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px;}
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    
    .btn-action {
        width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--border-color);
        background: var(--card-bg); color: var(--text-muted); display: flex; justify-content: center; align-items: center; cursor: pointer; transition: 0.2s;
    }
    .btn-action:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
    .view-section { display: none; height: 100%; }
    .view-section.active { display: block; animation: fadeEffect 0.4s; }
    @keyframes fadeEffect { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .fc { --fc-border-color: var(--border-color); --fc-page-bg-color: var(--card-bg); --fc-neutral-bg-color: var(--bg-color); --fc-list-event-hover-bg-color: var(--input-bg); color: var(--text-main); min-width: 0; width: 100%; font-family: 'Poppins', sans-serif; }
    .fc-toolbar-title { font-size: 1.4rem !important; text-transform: uppercase; color: var(--text-main); font-weight: 800; }
    .fc-button-primary { background-color: var(--input-bg) !important; border-color: var(--border-color) !important; color: var(--text-muted) !important; font-weight: 700 !important; text-transform: uppercase; border-radius: 8px !important; }
    .fc-button-primary:hover { background-color: var(--accent) !important; border-color: var(--accent) !important; color: white !important; }
    .fc-daygrid-day-number { color: var(--text-main); text-decoration: none; font-weight: 600; }
    .fc-col-header-cell-cushion { color: var(--text-muted); text-decoration: none; text-transform: uppercase; font-size: 0.85rem; font-weight: 700; }
    
    /* PROCON CARDS SERRALHERIA */
    .procon-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; margin-bottom: 20px; transition: transform 0.2s, box-shadow 0.2s; overflow: hidden; width: 100%; box-shadow: var(--shadow); }
    .procon-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
    .procon-header { padding: 20px; cursor: pointer; display: flex; flex-direction: column; gap: 8px; background: var(--input-bg); transition: 0.2s; }
    .procon-header:hover { filter: brightness(0.97); }
    .header-totals { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75rem; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--border-color); }
    .h-badge { padding: 4px 8px; border-radius: 6px; font-weight: 800; background: var(--card-bg); border: 1px solid var(--border-color); text-transform: uppercase; }
    .origin-badge { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.5px; padding: 4px 10px; border-radius: 6px; display: inline-block; width: fit-content; text-transform: uppercase; border: none;}
    .date-badge { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); margin-left: auto; display: flex; align-items: center; gap: 4px; }
    .origin-sede { background-color: var(--accent); color: #fff; }
    .origin-regional { background-color: #8d6e63; color: #fff; }
    .procon-title { font-weight: 800; color: var(--text-main); font-size: 1.1rem; line-height: 1.3; text-transform: uppercase; }
    
    .procon-details { background-color: var(--card-bg); padding: 0; }
    .procon-item-row { padding: 20px; border-bottom: 1px solid var(--border-color); }
    .procon-item-row:last-child { border-bottom: none; }
    .detail-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; font-size: 0.85rem; margin-bottom: 15px; }
    .detail-item strong { display: block; color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; font-weight: 700;}
    .detail-item span { color: var(--text-main); font-weight: 600; text-transform: uppercase; word-break: break-word; }
    .qty-badge { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; padding: 8px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); min-width: 50px; flex: 1; }
    .qty-val { font-weight: 800; font-size: 1.2rem; }
    .qty-lbl { font-size: 0.65rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; }

    .post-it-container { position: relative; display: inline-flex; align-items: center; margin-left: 6px; vertical-align: middle; }
    .post-it-icon { color: var(--warning-text-dark); font-size: 1.2rem; cursor: help; transition: transform 0.2s; }
    .post-it-icon:hover { transform: scale(1.2); }
    .post-it-tooltip {
        visibility: hidden; opacity: 0; position: absolute; bottom: 140%; left: 50%;
        transform: translateX(-50%) translateY(10px); width: max-content; max-width: 280px;
        background: var(--warning-bg); color: var(--warning-text-dark) !important;
        text-align: left; padding: 10px 14px; box-shadow: var(--shadow); z-index: 1060;
        font-size: 0.85rem; line-height: 1.4; border-radius: 12px; border: 1px solid var(--warning-text-dark);
        transition: all 0.2s ease-in-out; pointer-events: none; white-space: normal; font-weight: 500;
    }
    .post-it-tooltip::after {
        content: ""; position: absolute; top: 100%; left: 50%; margin-left: -6px; border-width: 6px;
        border-style: solid; border-color: var(--warning-bg) transparent transparent transparent;
    }
    .post-it-container:hover .post-it-tooltip { visibility: visible; opacity: 1; transform: translateX(-50%) translateY(0); }

    .sortable-header { cursor: pointer; user-select: none; white-space: normal; transition: filter 0.2s; }
    .sortable-header:hover { filter: brightness(0.85); }
    .sort-icon { font-size: 0.8rem; margin-left: 2px; opacity: 0.5; transition: opacity 0.2s, transform 0.2s; display: inline-block; }

    /* NOTIFICAÇÕES SERRALHERIA */
    .notif-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px); z-index: 10500; display: none; align-items: center; justify-content: center; animation: fadeEffect 0.3s; }
    .notif-box { background: var(--card-bg); width: 95%; max-width: 600px; max-height: 85vh; border-radius: 20px; display: flex; flex-direction: column; box-shadow: 0 15px 50px rgba(0,0,0,0.5); overflow: hidden; border: 1px solid var(--border-color); color: var(--text-main); }
    .notif-header { padding: 20px; background: var(--accent); color: #fff; display: flex; justify-content: space-between; align-items: center; }
    .notif-header h5 { margin: 0; font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 10px;}
    .notif-close { cursor: pointer; background: none; border: none; color: white; font-size: 24px; transition: 0.2s; }
    .notif-close:hover { transform: scale(1.1); color: var(--danger); }
    .notif-body { padding: 20px; overflow-y: auto; flex: 1; }
    .notif-footer { padding: 15px 20px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 10px; background: var(--input-bg); }
    
    .notif-item { border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; margin-bottom: 12px; }
    .notif-item-header { padding: 15px; background: var(--input-bg); cursor: pointer; transition: background 0.2s; }
    .notif-item-header:hover { filter: brightness(0.95); }
    .notif-item-header .header-row-1 { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;}
    .notif-item-header .header-row-2 { display: flex; justify-content: space-between; align-items: center; font-size: 13px;}
    .notif-item-header .material-icons { transition: transform 0.3s; color: var(--text-muted); }
    .notif-item-header.expanded .material-icons { transform: rotate(180deg); }
    .notif-item-body { display: none; padding: 15px; border-top: 1px solid var(--border-color); background: var(--card-bg); }
    .notif-item-body.show { display: block; }
    .notif-item-list { list-style: none; padding: 0; margin: 0; }
    .notif-item-list li { background: var(--input-bg); padding: 8px 12px; border-radius: 6px; margin-bottom: 5px; display: flex; justify-content: space-between; align-items: center; font-size: 13px; border: 1px dashed var(--border-color); }

    .btn-notif { padding: 10px 15px; border-radius: 8px; font-weight: 600; cursor: pointer; border: none; font-size: 14px; display: flex; align-items: center; gap: 8px; transition: 0.2s; font-family: 'Poppins', sans-serif;}
    .btn-notif-sec { background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-color); }
    .btn-notif-sec:hover { background: var(--border-color); }
    .btn-notif-pri { background: #4CAF50; color: white; }
    .btn-notif-pri:hover { background: #388E3C; }

    /* TOP BAR SERRALHERIA */
    .top-bar { padding: 15px 25px; margin-bottom: 30px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px; background: var(--card-bg); border-radius: 20px; box-shadow: var(--shadow); }
    .title-box { display: flex; align-items: center; gap: 10px; }
    .title-box h1 { margin: 0; font-size: 1.4rem; font-weight: 800; color: var(--text-main); text-transform: uppercase; } 
    .clock-display { font-size: 1.2rem; font-weight: 700; color: var(--accent); background: var(--input-bg); padding: 8px 16px; border-radius: 14px; display: flex; align-items: center; gap: 8px; }

    @media (max-width: 1199px) {
        .sidebar { left: -320px; width: 320px; }
        .sidebar.open { left: 0; }
        .main-content { margin-left: 0; width: 100vw; max-width: 100vw; padding: 15px; overflow-x: hidden; }

        .clock-display { display: none; }
        .top-bar { flex-direction: column; align-items: flex-start; }
        .top-bar > div:last-child {width: 100%; flex-wrap: wrap !important; justify-content: space-between;}
        #mobile-menu-btn { display: block !important; background: transparent; border: 1px solid var(--border-color); color: var(--text-main); border-radius: 12px; padding: 5px 10px; cursor: pointer;}
        
        .kpi-card { padding: 15px 10px !important; border-radius: 12px;}
        .kpi-val { font-size: 1.8rem !important; word-break: break-all; }
        .procon-kpi-val { font-size: 1.8rem !important; word-break: break-all; }
        .kpi-label { font-size: 0.7rem !important; margin-bottom: 4px; }
        
        .card-body { padding: 15px !important; }
        .pagination-container { flex-direction: column; gap: 15px; text-align: center; padding: 15px;}

        .custom-table, .sub-table, .modal-table { table-layout: auto !important; }
        .custom-table, .sub-table, .modal-table,
        .custom-table tbody, .sub-table tbody, .modal-table tbody { 
            display: block; width: 100%; border: none !important; background: transparent; 
        }
        .custom-table thead, .sub-table thead, .modal-table thead { display: none; }
        
        .custom-table tbody tr.parent-row {
            display: block; margin-bottom: 15px; background: var(--card-bg);
            border: 1px solid var(--border-color); border-radius: 12px; box-shadow: var(--shadow);
            padding: 0; width: 100%;
        }
        
        .custom-table tbody td, .sub-table tbody td, .modal-table tbody td {
            display: flex; justify-content: space-between; align-items: center; text-align: right;
            padding: 10px 15px !important; border-bottom: 1px solid var(--border-color) !important; border-top: none;
            gap: 10px; font-size: 0.85rem; width: 100%; word-break: normal; overflow-wrap: break-word;
        }
        .custom-table tbody td:last-child, .sub-table tbody td:last-child, .modal-table tbody td:last-child { border-bottom: none !important; }
        
        .custom-table tbody td::before, .sub-table tbody td::before, .modal-table tbody td::before {
            content: attr(data-label); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; 
            color: var(--text-muted); text-align: left; flex-shrink: 0; max-width: 45%; margin-right: 5px;
        }
        .custom-table tbody td > * { flex-shrink: 1; min-width: 0; }

        .sub-table tbody tr { 
            display: block;
            margin: 10px 0 15px 0; 
            background-color: var(--card-bg); 
            border: 1px solid var(--border-color);
            border-left: 4px solid var(--accent); 
            border-radius: 12px; 
            box-shadow: var(--shadow);
            width: 100%;
        }
        .sub-table tbody td {
            padding: 10px 15px !important;
            border-bottom: 1px dashed var(--border-color) !important;
        }
        
        .sim-input { width: 100%; max-width: 70px; font-size: 0.85rem; padding: 6px; text-align: center;}
        
        .viz-box { padding: 15px; min-height: auto; width: 100%; max-width: 100%; }
        .table-box { width: 100%; overflow-x: hidden; }
    }

  </style>
</head>
<body>

  <div id="loader" class="loader-overlay">
    <div class="spinner"></div>
    <div style="font-weight: 800; color: var(--text-muted); font-size: 1.2rem; letter-spacing: 1px;">CARREGANDO...</div>
  </div>

  <div class="layout-wrapper">
      <div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>
      
      <div class="sidebar" id="sidebar">
          <div style="width: 100%; display: flex; justify-content: center; align-items: center; padding-bottom: 20px; margin-bottom: 5px; border-bottom: 1px solid var(--border-color); position: relative;">
              <img src="/images/logo.png" alt="Logo" style="height: 100px; max-width: 85%; object-fit: contain;">
              <div style="position: absolute; top: 10px; right: 15px; cursor: pointer; display: flex; align-items: center; transition: transform 0.2s;" onclick="openNotifications()" title="Entregas da Semana" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                  <span class="material-icons" style="font-size: 26px; color: #ffffff;">notifications</span>
                  <span id="notifBadge" style="display:none; position: absolute; top: -5px; right: -5px; background: #E53935; color: white; font-size: 10px; font-weight: bold; width: 16px; height: 16px; border-radius: 50%; text-align: center; line-height: 16px; border: 2px solid var(--sidebar-bg);">0</span>
              </div>
          </div>

          <button class="nav-item nav-btn active" onclick="switchView('viewTable', this)"><i class="bi bi-table"></i> <span>Tabela</span></button>
          <button class="nav-item nav-btn" onclick="switchView('viewCalendar', this)"><i class="bi bi-calendar-event"></i> <span>Calendário</span></button>
          <button class="nav-item nav-btn" onclick="switchView('viewChart1', this)"><i class="bi bi-bar-chart-fill"></i> <span>Status</span></button>
          <button class="nav-item nav-btn" onclick="switchView('viewChart2', this)"><i class="bi bi-geo-alt-fill"></i> <span>Parceiros</span></button>
          <button class="nav-item nav-btn" onclick="switchView('viewChart3', this)"><i class="bi bi-boxes"></i> <span>Volume</span></button>
          <button class="nav-item nav-btn" onclick="switchView('viewProcon', this)"><i class="bi bi-building-gear"></i> <span>PROCON | TECH</span></button>
      </div>

      <div class="main-content">
          <div class="top-bar">
            <div class="title-box">
              <button id="mobile-menu-btn" style="display:none;" onclick="toggleSidebar()"><i class="material-icons">menu</i></button>
              <div>
                <h1 style="line-height: 1.1;">DASHBOARD - MARCENARIA</h1>
                <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; margin-top: 2px;">Marcenaria & Serralheria</div>
              </div>
            </div>
            <div style="display:flex; gap:15px; align-items:center; width: 100%; justify-content: flex-end;">
              <button class="btn-action" onclick="refreshCurrent(true)" title="Atualizar dados"><span class="material-icons">sync</span></button>
              <button class="btn-action" onclick="toggleTheme()" title="Modo Escuro"><span class="material-icons" id="themeIcon">dark_mode</span></button>
              <div class="clock-display" title="Hora atual"><span class="material-icons" style="font-size:22px;">schedule</span><span id="lastUpdate" style="font-variant-numeric: tabular-nums; min-width: 80px; text-align: center; display: inline-block;">...</span></div>
            </div>
          </div>

          <div id="mainSectionGroup">
              
              <div class="card-custom mb-4" style="position: relative; z-index: 100;">
                <div style="padding: 20px 25px;">
                  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                      <div class="flex-grow-1" data-bs-toggle="collapse" data-bs-target="#collapseFilters" aria-expanded="false" style="cursor: pointer; padding-block: 5px;">
                          <h6 class="fw-bold m-0" style="color: var(--accent); text-transform: uppercase; font-size: 1rem; display: flex; align-items: center; gap: 8px;">
                              <span class="material-icons" style="font-size: 20px;">filter_alt</span> Filtros Gerais <i class="bi bi-chevron-down ms-1 filter-chevron"></i>
                          </h6>
                      </div>
                      
                      <div class="d-flex gap-2 flex-wrap ms-2 align-items-center">
                          <button class="btn-notif btn-notif-sec" onclick="resetFilters()" style="padding: 8px 16px; border-radius: 12px;"><i class="bi bi-eraser-fill"></i> Limpar</button>
                          
                          <div class="dropdown">
                              <button class="btn-notif btn-notif-pri dropdown-toggle" type="button" data-bs-toggle="dropdown" style="border-radius: 12px;" id="btnExportExcelMain">
                                  <i class="bi bi-file-earmark-excel-fill"></i> EXCEL
                              </button>
                              <ul class="dropdown-menu dropdown-menu-end shadow" style="font-size: 0.85rem; z-index: 9999; border-radius: 12px; border: 1px solid var(--border-color); background: var(--card-bg);">
                                  <li><h6 class="dropdown-header fw-bold text-uppercase" style="color:var(--accent)">Separado por Processo</h6></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToExcel(1)">Com Material e Dimensão</a></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToExcel(2)">Apenas Mobília</a></li>
                                  <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                                  <li><h6 class="dropdown-header fw-bold text-uppercase" style="color:var(--accent)">Sem Processo (Consolidado)</h6></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToExcel(3)">Com Material e Dimensão</a></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToExcel(4)">Apenas Mobília (Geral)</a></li>
                              </ul>
                          </div>

                          <div class="dropdown">
                              <button class="btn-notif text-white dropdown-toggle" type="button" data-bs-toggle="dropdown" style="background-color: #d32f2f; border-radius: 12px;" id="btnExportPDFMain">
                                  <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                              </button>
                              <ul class="dropdown-menu dropdown-menu-end shadow" style="font-size: 0.85rem; z-index: 9999; border-radius: 12px; border: 1px solid var(--border-color); background: var(--card-bg);">
                                  <li><h6 class="dropdown-header fw-bold text-uppercase" style="color:var(--accent)">Separado por Processo</h6></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToPDF(1)">Com Material e Dimensão</a></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToPDF(2)">Apenas Mobília</a></li>
                                  <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                                  <li><h6 class="dropdown-header fw-bold text-uppercase" style="color:var(--accent)">Sem Processo (Consolidado)</h6></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToPDF(3)">Com Material e Dimensão</a></li>
                                  <li><a class="dropdown-item py-2" style="cursor: pointer; color: var(--text-main);" onclick="exportToPDF(4)">Apenas Mobília (Geral)</a></li>
                              </ul>
                          </div>
                      </div>
                  </div>
                  
                  <div class="collapse mt-3" id="collapseFilters">
                      <div class="row g-3">
                          <div class="col-lg-3 border-end" style="border-color: var(--border-color) !important;">
                              <label class="small fw-bold mb-1 text-uppercase" style="color: var(--text-muted); font-size: 0.75rem;">1. Selecione a Oficina</label>
                              <select id="selOficina" class="form-select oficina-selector mb-3" onchange="applyFilters('oficina')">
                                  <option value="TODAS" selected>TODAS AS OFICINAS</option>
                                  <option value="SEDE">MARCENARIA SEDE</option>
                                  <option value="REGIONAL">MARCENARIA REGIONAL</option>
                              </select>
                              
                              <label class="small fw-bold mb-1 text-uppercase" style="color: var(--text-muted); font-size: 0.75rem;">Data de Entrega</label>
                              <div class="d-flex gap-2 mb-3">
                                  <input type="date" id="filterDateStart" class="form-control oficina-selector" style="font-weight: normal; font-size: 0.85rem; padding: 10px;" onchange="applyFilters('date')">
                                  <input type="date" id="filterDateEnd" class="form-control oficina-selector" style="font-weight: normal; font-size: 0.85rem; padding: 10px;" onchange="applyFilters('date')">
                              </div>

                              <label class="small fw-bold mb-1 text-uppercase" style="color: var(--text-muted); font-size: 0.75rem;">Pesquisa por Palavra</label>
                              <input type="text" id="globalSearchInput" class="form-control oficina-selector" placeholder="Digite para filtrar..." style="font-weight: normal; font-size: 0.9rem;" onkeyup="applyFilters('global')">
                          </div>
                          <div class="col-lg-9">
                              <div class="row g-3" id="filterContainer"></div>
                          </div>
                      </div>
                  </div>
                </div>
              </div>

              <div class="row mb-4 g-3 w-100 m-0">
                <div class="col-4 col-md-4 p-0 pe-2"><div class="kpi-card blue"><div class="kpi-label" id="lblKpiSolicitada">SOLICITADO</div><div class="kpi-val" id="kpiSolicitada">0</div></div></div>
                <div class="col-4 col-md-4 p-0 px-1"><div class="kpi-card green"><div class="kpi-label">ENTREGUE</div><div class="kpi-val" id="kpiEntregue">0</div></div></div>
                <div class="col-4 col-md-4 p-0 ps-2"><div class="kpi-card yellow"><div class="kpi-label">PENDENTE</div><div class="kpi-val" id="kpiPendente">0</div></div></div>
