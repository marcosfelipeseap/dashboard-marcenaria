                          </div>
                          <button class="btn-notif btn-notif-sec ms-2" style="border-radius: 12px;" onclick="resetProconFilters();"><i class="bi bi-eraser-fill"></i> Limpar</button>
                      </div>
                      
                      <div class="collapse mt-3" id="collapseProconFilters">
                          <div class="row g-3">
                              <div class="col-md-4">
                                  <label class="small fw-bold mb-1 text-uppercase" style="color: var(--text-muted); font-size: 0.75rem;">Cidade/Local</label>
                                  <input type="text" id="proconSearchInput" class="form-control oficina-selector" placeholder="Ex: Centro, Bacabal..." style="font-weight: normal; font-size: 0.9rem;" onkeyup="filterProconData()">
