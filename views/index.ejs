              <div id="viewChart2" class="view-section"><div class="viz-box"><h5 class="chart-header">Solicitações por Parceiro (Local)</h5><div class="chart-container"><canvas id="chartParceiro"></canvas></div></div></div>
              <div id="viewChart3" class="view-section"><div class="viz-box"><h5 class="chart-header">Volume Total de Itens</h5><div class="chart-container"><canvas id="chartVolumeMovel"></canvas></div></div></div>
              
              <div id="viewProcon" class="view-section">
                  
                  <div class="row mb-4 g-3 w-100 m-0">
                      <div class="col-12 col-lg-6 p-0 pe-lg-2">
