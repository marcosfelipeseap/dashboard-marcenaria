     SEÇÃO 2: DETALHAMENTO & PARCEIROS ESTRATÉGICOS
     ========================================================= -->
<div style="margin-bottom: 40px;">
    
    <!-- Tabela Geral de Locais -->
    <div class="apres-box" style="margin-bottom: 30px;">
        <h3 class="apres-section-title" style="border: none; padding: 0; margin-bottom: 5px;"><span class="material-icons">business</span> Maiores Destinos (Geral)</h3>
        <p class="apres-box-subtitle">Ranking de unidades e órgãos que mais receberam mobílias.</p>
        
        <div class="apres-table-wrapper" style="max-height: 250px;">
            <table class="apres-table">
