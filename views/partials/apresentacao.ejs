                </table>
            </div>
        </div>

    </div>
</div>

<!-- =========================================================
     SCRIPT DE LÓGICA DA APRESENTAÇÃO
     ========================================================= -->
<script>
    let apresChartInstMarcenaria = null;
    let apresChartInstSerralheria = null;

    window.atualizarApresentacaoMarcenaria = function() {
        if (typeof filteredData === 'undefined') return;

        // Focamos apenas em registros ativos que já possuem entregas concluídas para a maior parte da tela
        const entregues = filteredData.filter(d => d._active && d.qtd_entregue > 0);

        // Globais
        let totalMoveisEntregues = 0;
        let processosUnicos = new Set();
        let locaisUnicos = new Set();
        let mapLocais = {};
        
        // Separação de Oficinas (Rankings)
        let mapMarcenaria = {};
        let mapSerralheria = {};
        
        // Parceiros - Lógica isolada para contar Total de Entregues
        let totalProcon = 0;
        let mapProcon = {};
        let totalTech = 0;
        let mapTech = {};

        // Agrupamento estrito para calcular os "FINALIZADOS"
        let groupsProcon = {};
        let groupsTech = {};

        // 1. Iteramos todos os itens filtrados e ativos para saber se um grupo PROCON/TECH está completamente finalizado
        filteredData.filter(d => d._active).forEach(d => {
            const locLower = (d.local || '').toLowerCase();
            const demLower = (d.demandante || '').toLowerCase();
            
            const isProcon = demLower.includes('procon') || locLower.includes('procon');
            const isTech = demLower.includes('estação tech') || locLower.includes('estação tech') || demLower.includes('estacao tech') || locLower.includes('estacao tech');

            if (isProcon || isTech) {
                // A mesma chave de agrupamento da página do Procon (local + origem)
                const key = d.local.trim().toUpperCase() + "|" + d.origem;
                if (isProcon) {
                    if (!groupsProcon[key]) groupsProcon[key] = [];
                    groupsProcon[key].push(d);
                }
                if (isTech) {
                    if (!groupsTech[key]) groupsTech[key] = [];
                    groupsTech[key].push(d);
                }
            }
        });

        // Contagem de Grupos Finalizados
        let proconFinalizados = 0;
        Object.values(groupsProcon).forEach(items => {
            const isFin = items.every(i => (i.status || '').toUpperCase().trim() === 'FINALIZADA' || (i.status || '').toUpperCase().trim() === 'FINALIZADO');
            if (isFin) proconFinalizados++;
        });

        let techFinalizados = 0;
        Object.values(groupsTech).forEach(items => {
            const isFin = items.every(i => (i.status || '').toUpperCase().trim() === 'FINALIZADA' || (i.status || '').toUpperCase().trim() === 'FINALIZADO');
            if (isFin) techFinalizados++;
        });

        // 2. Iteramos apenas os que tiveram entregas para montar os gráficos e os rankings
        entregues.forEach(d => {
            const qtd = d.qtd_entregue;
            totalMoveisEntregues += qtd;
            
            // Processos Globais
            const procValido = d.processo && d.processo.toUpperCase() !== 'S/N' && d.processo.trim() !== '';
            if (procValido) processosUnicos.add(d.processo);

            // Locais Globais
            const localNome = (d.local || "Não Identificado").trim().toUpperCase();
            locaisUnicos.add(localNome);
            mapLocais[localNome] = (mapLocais[localNome] || 0) + qtd;

            // Separação de Ranking: Marcenaria vs Serralheria
            const mobNome = (d.mobilia || "Sem Nome").trim().toUpperCase();
            if (d.tipo_servico === 'SERRALHERIA') {
                mapSerralheria[mobNome] = (mapSerralheria[mobNome] || 0) + qtd;
            } else {
                mapMarcenaria[mobNome] = (mapMarcenaria[mobNome] || 0) + qtd;
            }

            // Atribuir volumes entregues para Procon/Tech
            const demLower = (d.demandante || '').toLowerCase();
            const locLower = (d.local || '').toLowerCase();
            
            const isProcon = demLower.includes('procon') || locLower.includes('procon');
            const isTech = demLower.includes('estação tech') || locLower.includes('estação tech') || demLower.includes('estacao tech') || locLower.includes('estacao tech');

            if (isProcon) {
                totalProcon += qtd;
                mapProcon[mobNome] = (mapProcon[mobNome] || 0) + qtd;
            } else if (isTech) {
                totalTech += qtd;
                mapTech[mobNome] = (mapTech[mobNome] || 0) + qtd;
            }
        });

        // 3. Atualizar KPIs Gerais com Animação
        const runAnim = (id, endVal) => {
            const el = document.getElementById(id);
            if (!el) return;
            const startVal = parseInt(el.innerText.replace(/\D/g, '')) || 0;
            if (typeof animateValue === 'function') {
                animateValue(id, startVal, endVal, 1000);
            } else {
                el.innerText = endVal.toLocaleString('pt-BR');
            }
        };

        // Dados Gerais
        runAnim("apresKpiMoveis", totalMoveisEntregues);
        runAnim("apresKpiProcessos", processosUnicos.size);
        runAnim("apresKpiLocais", locaisUnicos.size);

        // Dados PROCON & TECH
        runAnim("apresKpiProconFin", proconFinalizados);
        runAnim("apresKpiProconMov", totalProcon);
        
        runAnim("apresKpiTechFin", techFinalizados);
        runAnim("apresKpiTechMov", totalTech);

        // Função auxiliar de render de tabelas
        const renderTabela = (mapObj, elementId, emptyMsg, colorHex = 'var(--accent)') => {
            const tbody = document.getElementById(elementId);
            tbody.innerHTML = '';
            const ordenados = Object.entries(mapObj).sort((a, b) => b[1] - a[1]);
            
            if (ordenados.length === 0) {
                tbody.innerHTML = `<tr><td colspan="2" style="text-align: center; color: var(--text-muted); font-weight: 500; padding: 20px;">${emptyMsg}</td></tr>`;
            } else {
                ordenados.forEach(([nome, qtd]) => {
                    tbody.innerHTML += `
                        <tr>
                            <td>${nome}</td>
                            <td style="text-align: right; color: ${colorHex}; font-weight: 800;">${qtd.toLocaleString('pt-BR')}</td>
                        </tr>`;
                });
            }
        };

        // 4. Preencher Tabelas
        renderTabela(mapLocais, 'apresTabelaLocais', 'Nenhuma entrega registrada.');
        renderTabela(mapProcon, 'apresTabelaProcon', 'Nenhuma mobília entregue para o PROCON neste filtro.', '#b91c1c');
        renderTabela(mapTech, 'apresTabelaTech', 'Nenhuma mobília entregue para a Estação Tech neste filtro.', '#0284c7');

        // 5. Preparar Dados para os Gráficos (Sem substring, mostrando texto completo)
        const topMarcenaria = Object.entries(mapMarcenaria).sort((a, b) => b[1] - a[1]).slice(0, 8);
        const lblsMarc = topMarcenaria.map(i => i[0]);
        const dataMarc = topMarcenaria.map(i => i[1]);

        const topSerralheria = Object.entries(mapSerralheria).sort((a, b) => b[1] - a[1]).slice(0, 8);
        const lblsSerr = topSerralheria.map(i => i[0]);
        const dataSerr = topSerralheria.map(i => i[1]);

        renderizarGraficosRanking(lblsMarc, dataMarc, lblsSerr, dataSerr);
    }

    function renderizarGraficosRanking(lblsMarc, dataMarc, lblsSerr, dataSerr) {
        const isDark = document.body.classList.contains('dark-mode');
        const textColor = isDark ? '#f0f2f5' : '#1e293b';
        
        // Cores CSS Variables
        const corMarcenaria = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#001E7A';
        const corSerralheria = getComputedStyle(document.documentElement).getPropertyValue('--warning-text-dark').trim() || '#e65100';

        const chartOptions = (textColor) => ({
            indexAxis: 'y', // Eixo Horizontal para textos compridos não colidirem
            responsive: true, maintainAspectRatio: false,
            layout: { padding: { right: 35 } },
            plugins: {
                legend: { display: false },
                datalabels: { anchor: 'end', align: 'right', color: textColor, font: { weight: 'bold', family: 'Poppins', size: 11 } }
            },
            scales: {
                x: { display: false },
                y: { grid: { display: false }, ticks: { color: textColor, font: { family: 'Poppins', weight: '600', size: 10 } } }
            }
        });

        // Gráfico 1: Top Marcenaria
        const ctxMarc = document.getElementById('apresChartTopMarcenaria').getContext('2d');
        if (apresChartInstMarcenaria) apresChartInstMarcenaria.destroy();
        
        apresChartInstMarcenaria = new Chart(ctxMarc, {
            type: 'bar',
            data: {
                labels: lblsMarc,
                datasets: [{ data: dataMarc, backgroundColor: corMarcenaria, borderRadius: 6 }]
            },
            options: chartOptions(textColor)
        });

        // Gráfico 2: Top Serralheria
        const ctxSerr = document.getElementById('apresChartTopSerralheria').getContext('2d');
        if (apresChartInstSerralheria) apresChartInstSerralheria.destroy();
        
        apresChartInstSerralheria = new Chart(ctxSerr, {
            type: 'bar',
            data: {
                labels: lblsSerr,
                datasets: [{ data: dataSerr, backgroundColor: corSerralheria, borderRadius: 6 }]
            },
            options: chartOptions(textColor)
        });
    }

    // ========================================================
    // SEQUESTRO DO CICLO DE VIDA DO DASHBOARD (Patch Seguro)
    // ========================================================
    let _painelApresIniciado = false;
    
    const initInterval = setInterval(() => {
        if (typeof window.populateApresentacao === 'function') {
            
            window.populateApresentacao = function() {
                window.atualizarApresentacaoMarcenaria();
            };
            
            if (typeof window.updateDashboard === 'function' && !window._apresPatched) {
                const originalUpdateDashboard = window.updateDashboard;
                window.updateDashboard = function() {
                    originalUpdateDashboard(); 
                    window.atualizarApresentacaoMarcenaria();
                };
                window._apresPatched = true;
            }
            
            if (typeof filteredData !== 'undefined' && filteredData.length > 0 && !_painelApresIniciado) {
                window.atualizarApresentacaoMarcenaria();
                _painelApresIniciado = true;
            }
            
            if (window._apresPatched) clearInterval(initInterval);
        }
    }, 150);
</script>