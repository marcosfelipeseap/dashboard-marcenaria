        top: 0;
        background: var(--card-bg);
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 800;
        z-index: 2;
    }

    .apres-table td {
        padding: 12px 10px;
        border-bottom: 1px dashed var(--border-color);
        font-weight: 600;
        color: var(--text-main);
    }
</style>

