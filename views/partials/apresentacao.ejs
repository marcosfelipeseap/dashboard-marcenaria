    <!-- PROCON e Estação Tech Separados -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 25px;">
        
        <!-- Bloco PROCON -->
        <div class="apres-box" style="border: 2px solid #b91c1c; background: linear-gradient(180deg, var(--card-bg) 60%, rgba(185, 28, 28, 0.05) 100%);">
            <h3 class="apres-section-title" style="border-left-color: #b91c1c; color: #b91c1c; padding: 0; margin-bottom: 15px; border:none; display: flex; align-items: center; gap: 8px;">
                <span class="material-icons">gavel</span> PROCON
            </h3>
            
            <div style="display: flex; gap: 15px; margin-bottom: 20px;">
