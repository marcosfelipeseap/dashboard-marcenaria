                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bloco ESTAÇÃO TECH -->
        <div class="apres-box" style="border: 2px solid #0284c7; background: linear-gradient(180deg, var(--card-bg) 60%, rgba(2, 132, 199, 0.05) 100%);">
            <h3 class="apres-section-title" style="border-left-color: #0284c7; color: #0284c7; padding: 0; margin-bottom: 15px; border:none; display: flex; align-items: center; gap: 8px;">
                <span class="material-icons">computer</span> Estação Tech
            </h3>
            
            <div style="display: flex; gap: 15px; margin-bottom: 20px;">
                <div style="background: var(--success-bg); border: 1px solid rgba(27, 94, 32, 0.15); color: var(--success); padding: 12px; border-radius: 12px; flex: 1; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
                    <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700;"><i class="bi bi-check-circle-fill me-1"></i> FINALIZADOS</div>
                    <div id="apresKpiTechFin" style="font-size: 1.8rem; font-weight: 900; line-height: 1.1;">0</div>
                </div>
                <div style="background: #0284c7; color: white; padding: 12px; border-radius: 12px; flex: 1; text-align: center; box-shadow: 0 4px 6px rgba(2, 132, 199, 0.2);">
